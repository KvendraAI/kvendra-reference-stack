# SPDX-License-Identifier: MIT
# kvendra-reference-stack — env example
#
# Copy to `.env` and adapt. `.env` is in .gitignore — never commit secrets.
#
# Two built-in modes (see docs/modes.md):
#   Ollama (default) — everything local, no account needed. `./scripts/up.sh`
#                      starts the kvendra-ollama container and pulls the
#                      embeddings model (mxbai-embed-large, 1024-dim).
#   Mock   (CI/dev)  — deterministic test vectors, no external calls.
#
# Prefer your own OpenAI-compatible embeddings provider? See the commented
# block below and start with `./scripts/up.sh --no-ollama`.

# =============================================================================
# Postgres (kvendra-db)
# =============================================================================
POSTGRES_USER=kvendra
POSTGRES_PASSWORD=kvendra
POSTGRES_DB=kvendra_platform

# =============================================================================
# Platform (kvendra-platform)
# =============================================================================
PLATFORM_HOST_PORT=7777
LOG_LEVEL=info
STAGE=local

# --- Embeddings provider --------------------------------------------------
# Allowed values: mock | openai-compatible | bedrock
#   mock              — deterministic test vectors, no external calls.
#   openai-compatible — Ollama, vLLM, TEI, llama.cpp, Mistral, LiteLLM, ...
#   bedrock           — NOT available in this stack (AGPL boundary; ADR-KVD-1823F7).
#
# Active defaults: local Ollama (the kvendra-ollama container, started by
# default). No API key needed.
EMBEDDINGS_PROVIDER=openai-compatible
EMBEDDINGS_BASE_URL=http://kvendra-ollama:11434/v1
EMBEDDINGS_MODEL=mxbai-embed-large
EMBEDDINGS_API_KEY=

# --- Alternative: your own OpenAI-compatible provider ------------------------
# The Platform validates 1024-dim vectors and does NOT send a `dimensions`
# parameter, so use a model that is NATIVELY 1024-dim, e.g.:
#   - vLLM / Hugging Face TEI serving mxbai-embed-large or bge-large-en-v1.5
#   - Mistral `mistral-embed`
#   - a gateway (e.g. LiteLLM) in front of Bedrock Titan v2 / OpenAI v3 that
#     pins the output to 1024 dimensions
# Then start the stack with `./scripts/up.sh --no-ollama`.
# EMBEDDINGS_PROVIDER=openai-compatible
# EMBEDDINGS_BASE_URL=https://your-provider.example.com/v1
# EMBEDDINGS_MODEL=mxbai-embed-large
# EMBEDDINGS_API_KEY=your-provider-key

# --- Switching provider = re-embedding ---------------------------------------
# Changing provider or model changes the vector space, even when both produce
# 1024-dim vectors. Vectors stored with the old provider are NOT comparable
# with the new ones: re-embed your existing entities after switching (or start
# from an empty KB), otherwise semantic search returns poor results.

# --- Alternative mode: mock (CI / dev) ---------------------------------------
# EMBEDDINGS_PROVIDER=mock
# EMBEDDINGS_BASE_URL=
# EMBEDDINGS_MODEL=
# EMBEDDINGS_API_KEY=

EMBEDDINGS_TIMEOUT_MS=30000

# =============================================================================
# Ollama runtime (kvendra-ollama) — started by default (skip: up.sh --no-ollama)
# =============================================================================
OLLAMA_HOST_PORT=11434

# Models pulled at first startup by ./scripts/up.sh.
# Comma-separated list. Empty = no pull (you do it manually with `ollama pull`).
# Heads-up: each model is 1–10 GB.
# The platform ONLY needs the embeddings model (mxbai-embed-large). The LLM is
# BYOK via the orchestrator (Claude Code), so we don't preload a multi-GB LLM
# here. If you want a local LLM too, append it (e.g. `,llama3.1:8b`).
OLLAMA_MODELS_PRELOAD=mxbai-embed-large

# =============================================================================
# Backup sidecar (kvendra-backup)
# =============================================================================
# Cron syntax: minute hour dom month dow
# Default: daily at 03:30 (container TZ = UTC unless you mount /etc/timezone).
BACKUP_CRON="30 3 * * *"
BACKUP_RETENTION_DAYS=14
